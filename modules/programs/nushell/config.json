{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "#6965a6",
          "foreground": "#dadada",
          "leading_diamond": "",
          "style": "diamond",
          "template": " {{.Icon}} \ue0b1",
          "trailing_diamond": "\ue0b0",
          "type": "os"
        },
        {
          "background": "#d6b471",
          "foreground":  "#161616",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " {{ .UserName }}@{{ .HostName }} ",
          "type": "session"
        },
        {
          "background": "#dadada",
          "foreground": "#161616",
          "powerline_symbol": "\ue0b0",
          "options": {
            "style": "folder"
          },
          "style": "powerline",
          "template": " \ue5ff {{ .Path }} ",
          "type": "path"
        },
        {
          "background": "#3395b2",
          "foreground": "#dadada",
          "powerline_symbol": "\ue0b0",
          "options": {
            "fetch_upstream_icon": true
          },
          "style": "powerline",
          "template": " {{ .UpstreamIcon }}  {{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        },
        {
          "background": "#8ed671",
          "foreground": "#161616",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "type": "node"
        },
        {
          "background": "#d6717b",
          "foreground": "#dadada",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf0e7",
          "type": "root"
        },
        {
          "background": "#606060",
          "foreground": "#dadada",
          "powerline_symbol": "\ue0b0",
          "style": "powerline",
          "template": " \uf308 {{.Context}} :: {{ if .Namespace}}{{.Namespace}}{{else}}default{{end}} ",
          "type": "kubectl"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#6965a6",
          "style": "plain",
          "template": "\u2192",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
